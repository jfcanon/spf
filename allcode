import { setAudioModeAsync, useAudioPlayer, useAudioPlayerStatus } from "expo-audio";
import { createContext, ReactNode, useCallback, useContext, useEffect, useMemo, useRef, useState } from "react";

import { api, post, Track } from "@/src/api";
import { queryClient } from "@/src/query-client";

type PlayerState = {
  current?: Track;
  queue: Track[];
  index: number;
  playing: boolean;
  loading: boolean;
  position: number;
  duration: number;
  shuffle: boolean;
  repeat: boolean;
  playQueue: (tracks: Track[], index: number) => void;
  toggle: () => void;
  next: () => void;
  prev: () => void;
  seek: (sec: number) => void;
  toggleShuffle: () => void;
  toggleRepeat: () => void;
};

const PlayerContext = createContext<PlayerState | null>(null);

const shuffled = <T,>(arr: T[]) => [...arr].sort(() => Math.random() - 0.5);

export function PlayerProvider({ children }: { children: ReactNode }) {
  const player = useAudioPlayer(null, { updateInterval: 500 });
  const status = useAudioPlayerStatus(player);
  const [queue, setQueue] = useState<Track[]>([]);
  const [index, setIndex] = useState(-1);
  const [shuffle, setShuffle] = useState(false);
  const [repeat, setRepeat] = useState(false);
  const [loading, setLoading] = useState(false);
  const token = useRef(0);

  useEffect(() => {
    setAudioModeAsync({ playsInSilentMode: true }).catch(() => {});
  }, []);

  const load = useCallback(
    async (tracks: Track[], i: number) => {
      const t = tracks[i];
      if (!t) return;
      const my = ++token.current;
      setQueue(tracks);
      setIndex(i);
      setLoading(true);
      let uri = t.preview;
      try {
        uri = (await api<Track>(`/tracks/${t.id}`)).preview; // Deezer preview links expire, refresh before play
      } catch {}
      if (my !== token.current) return;
      player.replace({ uri });
      player.play();
      setLoading(false);
      post("/recent", t)
        .then(() => {
          queryClient.invalidateQueries({ queryKey: ["home"] });
          queryClient.invalidateQueries({ queryKey: ["collection", "recent"] });
        })
        .catch(() => {});
    },
    [player],
  );

  const playQueue = useCallback(
    (tracks: Track[], i: number) => {
      if (shuffle) {
        const first = tracks[i];
        load([first, ...shuffled(tracks.filter((_, j) => j !== i))], 0);
      } else load(tracks, i);
    },
    [load, shuffle],
  );

  const next = useCallback(() => {
    if (index < queue.length - 1) load(queue, index + 1);
    else if (queue.length) load(queue, 0);
  }, [index, queue, load]);

  const prev = useCallback(() => {
    if (status.currentTime > 3 || index === 0) player.seekTo(0);
    else load(queue, index - 1);
  }, [status.currentTime, index, queue, load, player]);

  useEffect(() => {
    if (!status.didJustFinish) return;
    if (repeat) {
      player.seekTo(0);
      player.play();
    // eslint-disable-next-line react-hooks/set-state-in-effect
    } else if (index < queue.length - 1) next();
    else {
      player.pause();
      player.seekTo(0);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [status.didJustFinish]);

  const value = useMemo<PlayerState>(
    () => ({
      current: queue[index],
      queue,
      index,
      playing: status.playing,
      loading: loading || (!!queue[index] && !status.isLoaded),
      position: status.currentTime,
      duration: status.duration || queue[index]?.duration || 30,
      shuffle,
      repeat,
      playQueue,
      toggle: () => (status.playing ? player.pause() : player.play()),
      next,
      prev,
      seek: (sec: number) => player.seekTo(sec),
      toggleShuffle: () =>
        setShuffle((s) => {
          if (!s && queue.length > 1) {
            const cur = queue[index];
            setQueue([cur, ...shuffled(queue.filter((_, j) => j !== index))]);
            setIndex(0);
          }
          return !s;
        }),
      toggleRepeat: () => setRepeat((r) => !r),
    }),
    [queue, index, status, loading, shuffle, repeat, playQueue, next, prev, player],
  );

  return <PlayerContext.Provider value={value}>{children}</PlayerContext.Provider>;
}

export function usePlayer() {
  const ctx = useContext(PlayerContext);
  if (!ctx) throw new Error("usePlayer must be inside PlayerProvider");
  return ctx;
}
