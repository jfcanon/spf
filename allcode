import { useQuery } from "@tanstack/react-query";
import { Image } from "expo-image";
import { useMemo } from "react";
import { ActivityIndicator, Pressable, RefreshControl, ScrollView, Text, View } from "react-native";
import Animated, { FadeInDown } from "react-native-reanimated";
import { useSafeAreaInsets } from "react-native-safe-area-context";

import { api, HomeData, Track } from "@/src/api";
import { Rail } from "@/src/components/media-card";
import { MiniPlayer } from "@/src/components/mini-player";
import { usesNativeTabs } from "@/src/navigation";
import { usePlayer } from "@/src/player";
import { makeStyles, useTheme } from "@/src/theme";

const greeting = () => {
  const h = new Date().getHours();
  return h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
};

export default function Home() {
  const styles = useStyles();
  const { colors } = useTheme();
  const insets = useSafeAreaInsets();
  const bottomChrome = usesNativeTabs ? insets.bottom : 0;
  const { playQueue, current } = usePlayer();
  const { data, isLoading, isError, refetch, isRefetching } = useQuery({
    queryKey: ["home"],
    queryFn: () => api<HomeData>("/home"),
  });

  const trackCards = useMemo(
    () => (data?.top_tracks ?? []).map((t: Track) => ({ id: t.id, title: t.title, subtitle: t.artist, cover: t.cover, type: "album" as const })),
    [data],
  );

  return (
    <View style={styles.screen} testID="home-screen">
      <View style={[styles.header, { paddingTop: insets.top + 8 }]}>
        <Text style={styles.greeting} testID="home-greeting">{greeting()}</Text>
      </View>
      {isLoading ? (
        <ActivityIndicator style={styles.center} color={colors.brandPrimary} size="large" testID="home-loading" />
      ) : isError ? (
        <View style={styles.center}>
          <Text style={styles.muted}>Could not load your feed</Text>
          <Pressable testID="home-retry" onPress={() => refetch()} style={styles.retry}>
            <Text style={styles.retryText}>Retry</Text>
          </Pressable>
        </View>
      ) : (
        <ScrollView
          contentContainerStyle={{ paddingBottom: bottomChrome + (current ? 88 : 24) }}
          refreshControl={<RefreshControl refreshing={isRefetching} onRefresh={() => { refetch(); }} tintColor={colors.brandPrimary} />}
        >
          {!!data?.recent.length && (
            <View style={styles.grid} testID="home-recent-grid">
              {data.recent.slice(0, 6).map((t, i) => (
                <Animated.View key={t.id} entering={FadeInDown.delay(i * 40)} style={styles.tileWrap}>
                  <Pressable
                    testID={`recent-tile-${t.id}`}
                    onPress={() => playQueue(data.recent, i)}
                    style={({ pressed }) => [styles.tile, pressed && { opacity: 0.7 }]}
                  >
                    <Image source={{ uri: t.cover_small }} style={styles.tileImg} />
                    <Text numberOfLines={2} style={styles.tileText}>{t.title}</Text>
