import { Ionicons } from "@react-native-vector-icons/ionicons";
import { useQuery } from "@tanstack/react-query";
import { Image } from "expo-image";
import { LinearGradient } from "expo-linear-gradient";
import { router, useLocalSearchParams } from "expo-router";
import { useState } from "react";
import { ActivityIndicator, FlatList, Modal, Pressable, Text, View } from "react-native";
import { useSafeAreaInsets } from "react-native-safe-area-context";

import { api, Collection, del, Playlist, Track, useLikedIds } from "@/src/api";
import { MiniPlayer } from "@/src/components/mini-player";
import { useToast } from "@/src/components/toast";
import { TrackRow } from "@/src/components/track-row";
import { usePlayer } from "@/src/player";
import { queryClient } from "@/src/query-client";
import { makeStyles, useTheme } from "@/src/theme";

const LIKED_COVER =
  "https://images.unsplash.com/photo-1629197520635-16570fbd0bb3?crop=entropy&cs=srgb&fm=jpg&q=60&w=600";
const PLAYLIST_COVER =
  "https://images.unsplash.com/photo-1459749411175-04bf5292ceea?crop=entropy&cs=srgb&fm=jpg&q=60&w=600";

async function fetchCollection(type: string, id: string): Promise<Collection> {
  switch (type) {
    case "album":
      return api(`/albums/${id}`);
    case "playlist":
      return api(`/deezer-playlists/${id}`);
    case "artist":
      return api(`/artists/${id}`);
    case "genre":
      return api(`/genres/${id}`);
    case "liked": {
      const tracks = await api<Track[]>("/liked");
      return { id, title: "Liked Songs", subtitle: `${tracks.length} songs`, cover: LIKED_COVER, type, tracks };
    }
    case "recent": {
      const tracks = await api<Track[]>("/recent?limit=50");
      return { id, title: "Recently played", subtitle: `${tracks.length} songs`, cover: tracks[0]?.cover || PLAYLIST_COVER, type, tracks };
    }
    default: {
      const p = await api<Playlist>(`/playlists/${id}`);
      return { id, title: p.name, subtitle: `${p.tracks.length} songs`, cover: p.tracks[0]?.cover || PLAYLIST_COVER, type, tracks: p.tracks };
    }
  }
}

export default function CollectionScreen() {
  const { type, id } = useLocalSearchParams<{ type: string; id: string }>();
  const styles = useStyles();
  const { colors } = useTheme();
  const insets = useSafeAreaInsets();
  const toast = useToast();
  const { playQueue, current, playing, toggle } = usePlayer();
  const likedIds = useLikedIds();
  const [confirmDelete, setConfirmDelete] = useState(false);
  const { data, isLoading, isError, refetch } = useQuery({
    queryKey: ["collection", type, id],
    queryFn: () => fetchCollection(type, id),
  });

  const tracks = data?.tracks ?? [];
  const isCurrent = !!current && tracks.some((t) => t.id === current.id);
  const round = type === "artist";

  const deletePlaylist = async () => {
    await del(`/playlists/${id}`);
    await queryClient.invalidateQueries({ queryKey: ["playlists"] });
    setConfirmDelete(false);
    toast("Playlist deleted");
    router.back();
  };

  return (
    <View style={styles.screen} testID="collection-screen">
      {isLoading ? (
        <ActivityIndicator style={styles.center} color={colors.brandPrimary} size="large" testID="collection-loading" />
      ) : isError || !data ? (
        <View style={styles.center}>
          <Text style={styles.muted}>Could not load this page</Text>
          <Pressable testID="collection-retry" onPress={() => refetch()}>
            <Text style={styles.link}>Retry</Text>
          </Pressable>
        </View>
      ) : (
        <FlatList
          data={tracks}
          keyExtractor={(t) => t.id}
          contentContainerStyle={{ paddingBottom: insets.bottom + (current ? 96 : 24) }}
          ListHeaderComponent={
            <View>
              <LinearGradient
                colors={[colors.brandTertiary, colors.surface]}
                style={[styles.hero, { paddingTop: insets.top + 56 }]}
              >
                <Image source={{ uri: data.cover }} style={[styles.cover, round && styles.round]} contentFit="cover" transition={200} />
              </LinearGradient>
              <View style={styles.meta}>
                <Text style={styles.title} numberOfLines={2} testID="collection-title">{data.title}</Text>
                <Text style={styles.muted} numberOfLines={2}>{data.subtitle}</Text>
                <View style={styles.actions}>
                  {type === "mine" && (
                    <Pressable testID="collection-delete-playlist" onPress={() => setConfirmDelete(true)} style={styles.iconBtn}>
                      <Ionicons name="trash-outline" size={24} color={colors.muted} />
                    </Pressable>
                  )}
                  <View style={{ flex: 1 }} />
                  <Pressable
                    testID="collection-shuffle"
                    disabled={!tracks.length}
                    onPress={() => playQueue([...tracks].sort(() => Math.random() - 0.5), 0)}
                    style={styles.iconBtn}
                  >
                    <Ionicons name="shuffle" size={28} color={colors.muted} />
                  </Pressable>
                  <Pressable
                    testID="collection-play"
                    disabled={!tracks.length}
                    onPress={() => (isCurrent ? toggle() : playQueue(tracks, 0))}
                    style={({ pressed }) => [styles.play, pressed && { transform: [{ scale: 0.95 }] }, !tracks.length && { opacity: 0.4 }]}
                  >
                    <Ionicons name={isCurrent && playing ? "pause" : "play"} size={28} color={colors.onBrandPrimary} />
                  </Pressable>
                </View>
              </View>
            </View>
          }
          ListEmptyComponent={
            <View style={styles.empty} testID="collection-empty">
              <Ionicons name="musical-notes-outline" size={40} color={colors.muted} />
              <Text style={styles.muted}>
                {type === "liked" ? "Songs you like will appear here" : type === "mine" ? "Add songs via the ••• menu on any track" : "Nothing here yet"}
              </Text>
            </View>
          }
          renderItem={({ item, index }) => (
            <TrackRow
              track={item}
              liked={likedIds.has(item.id)}
              playlistId={type === "mine" ? id : undefined}
              onPress={() => playQueue(tracks, index)}
            />
          )}
        />
      )}
      <Pressable
        testID="collection-back"
        onPress={() => (router.canGoBack() ? router.back() : router.replace("/"))}
        style={[styles.back, { top: insets.top + 8 }]}
      >
        <Ionicons name="chevron-back" size={24} color={colors.onSurface} />
      </Pressable>
      <MiniPlayer bottom={insets.bottom + 8} />
      <Modal visible={confirmDelete} transparent animationType="fade" onRequestClose={() => setConfirmDelete(false)}>
        <View style={styles.backdrop}>
          <View style={styles.dialog} testID="delete-playlist-dialog">
            <Text style={styles.dialogTitle}>Delete this playlist?</Text>
            <Text style={styles.muted}>This can&apos;t be undone.</Text>
            <View style={styles.dialogActions}>
              <Pressable testID="delete-playlist-cancel" onPress={() => setConfirmDelete(false)} style={styles.dialogBtn}>
                <Text style={styles.dialogBtnText}>Cancel</Text>
              </Pressable>
              <Pressable testID="delete-playlist-confirm" onPress={deletePlaylist} style={[styles.dialogBtn, styles.danger]}>
                <Text style={[styles.dialogBtnText, { color: colors.onError }]}>Delete</Text>
              </Pressable>
            </View>
          </View>
        </View>
      </Modal>
    </View>
  );
}

const useStyles = makeStyles((c) => ({
  screen: { flex: 1, backgroundColor: c.surface },
